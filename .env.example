# Which model provider to use: gemini | groq | openrouter | ollama | custom | mock
# Leave LLM_PROVIDER and LLM_API_KEY empty to run in demo mode (built-in mock, no network).
LLM_PROVIDER=gemini

# API key for the chosen provider. Never exposed to the browser.
#   Gemini (free tier): https://aistudio.google.com/apikey
#   Groq (free tier):   https://console.groq.com/keys
#   OpenRouter:         https://openrouter.ai/keys
# Not needed for ollama or mock.
LLM_API_KEY=

# Optional overrides. Each provider has a sensible default model.
# LLM_MODEL=gemini-flash-latest
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Models to try, in order, when the main one is overloaded (5xx), rate limited (429)
# or not found. Gemini defaults to gemini-flash-lite-latest. "none" turns this off.
# LLM_FALLBACK_MODELS=gemini-flash-lite-latest
# Ask the provider for JSON mode (response_format: json_object). Default: true.
# LLM_JSON_MODE=true

# Port for the API server. Vite proxies /api here in development.
PORT=8787

# Requests per minute per client, and across all clients, before the server answers 429.
# RATE_LIMIT_PER_MINUTE=20
# GLOBAL_RATE_LIMIT_PER_MINUTE=60

# Behind a hosting proxy (Render, Fly, Railway…), how many proxy hops to trust
# when reading the visitor's IP from X-Forwarded-For. Leave unset locally.
# TRUST_PROXY=1

# Show the "Test failure handling" panel and accept simulated failures.
# On by default in development; set to false before deploying.
# ALLOW_SIMULATE=true
